{
    "name": "youandme/auth",
    "description": "Youandme Auth — reusable authentication module (Ja i Ty).",
    "type": "library",
    "license": "proprietary",
    "version": "0.1.0",
    "require": {
        "php": "^8.3"
    },
    "autoload": {
        "psr-4": {
