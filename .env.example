APP_NAME=YouAndMe
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=youandme_api
DB_USERNAME=youandme
DB_PASSWORD=lokalne

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database

SANCTUM_STATEFUL_DOMAINS=

# Lokalnie używamy Mailpit (Web UI http://localhost:8025). Produkcyjnie Resend przez RESEND_KEY.
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@jaity.local"
MAIL_FROM_NAME="${APP_NAME}"

RESEND_KEY=

GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
