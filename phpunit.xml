<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Auth">
            <directory>packages/auth/src/Tests</directory>
        </testsuite>
        <testsuite name="Catalog">
            <directory>app/Modules/Catalog/Tests</directory>
        </testsuite>
        <testsuite name="Notifications">
            <directory>packages/notifications/src/Tests</directory>
        </testsuite>
        <testsuite name="Game">
            <directory>app/Modules/Game/Tests</directory>
        </testsuite>
        <testsuite name="Memories">
            <directory>app/Modules/Memories/Tests</directory>
        </testsuite>
        <testsuite name="Rewards">
            <directory>app/Modules/Rewards/Tests</directory>
        </testsuite>
        <testsuite name="Premium">
            <directory>app/Modules/Premium/Tests</directory>
        </testsuite>
        <testsuite name="Progress">
            <directory>app/Modules/Progress/Tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
            <directory>packages/auth/src</directory>
            <directory>packages/notifications/src</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="5433"/>
        <env name="DB_DATABASE" value="youandme_api_testing"/>
        <env name="DB_USERNAME" value="youandme"/>
        <env name="DB_PASSWORD" value="lokalne"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
